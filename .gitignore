
# ==========================================
# SMART RETAIL DEMAND FORECASTING SYSTEM
# GitHub + Streamlit Community Cloud
# ==========================================

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build and distribution
build/
dist/
*.egg-info/
.eggs/
wheels/
share/python-wheels/
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
.streamlit/credentials.toml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter notebook files
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ==========================================
# DATASETS
# Keep deployment datasets
# ==========================================
data/*
!data/.gitkeep
!data/*.csv

# ==========================================
# TRAINED MODELS AND RESULTS
# Keep required model artifacts
# ==========================================
models/*
!models/.gitkeep
!models/*.joblib
!models/*.pkl
!models/*.csv

# ==========================================
# Logs and operating system files
# ==========================================
*.log
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
